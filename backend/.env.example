# ==============================================================================
# Backend Configuration (.env.example)
# Copy this file to .env and adjust variables for your local setup.
# ==============================================================================

PROJECT_NAME="Subscription Billing Automation System"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

HOST="0.0.0.0"
PORT=8000

# PostgreSQL Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_this_to_a_secure_password"
POSTGRES_DB="subscription_billing_db"
POSTGRES_TEST_DB="subscription_billing_test_db"

# Optional explicit DATABASE_URL / TEST_DATABASE_URL
# DATABASE_URL="postgresql+psycopg2://postgres:change_this_to_a_secure_password@localhost:5432/subscription_billing_db"
# TEST_DATABASE_URL="postgresql+psycopg2://postgres:change_this_to_a_secure_password@localhost:5432/subscription_billing_test_db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# Redis & Celery Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_RESULT_DB=1
# REDIS_PASSWORD=""
# CELERY_BROKER_URL="redis://localhost:6379/0"
# CELERY_RESULT_BACKEND="redis://localhost:6379/1"
CELERY_TIMEZONE="UTC"
CELERY_TASK_ALWAYS_EAGER=false
BILLING_SCHEDULER_INTERVAL_SECONDS=3600
CELERY_TASK_MAX_RETRIES=3
CELERY_TASK_RETRY_DELAY_SECONDS=60

